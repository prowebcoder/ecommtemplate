# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://veloire:veloire_secret@localhost:5432/veloire?schema=public"

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Veloire <onboarding@resend.dev>

# Payments (India: Razorpay primary — UPI, cards, netbanking, wallets)
# Create keys at https://dashboard.razorpay.com — use test keys for staging
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_WEBHOOK_SECRET=
# Must be the same Key ID as RAZORPAY_KEY_ID (public, safe for browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# Webhook URL: https://your-domain.com/api/webhooks/razorpay
# Optional international fallback (not required for India storefront)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=veloire-uploads
R2_PUBLIC_URL=
